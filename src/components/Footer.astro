---
const year = new Date().getFullYear();
---

<footer class="bg-soil-800 text-cream-100 mt-auto">
  <div class="container-content py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <!-- ブランド -->
      <div>
        <p class="font-serif text-xl font-semibold text-cream-200 mb-3">ハニヤス合同会社</p>
        <p class="text-sm text-soil-300 leading-relaxed">
          人と組織の豊かな未来をつくる。<br />
          教育支援・経営支援を通じて、<br />
          未来のタネをまきます。
        </p>
      </div>

      <!-- ナビゲーション -->
      <nav aria-label="フッターナビゲーション">
        <p class="text-xs font-medium uppercase tracking-widest text-soil-400 mb-4">サイトマップ</p>
        <ul class="space-y-2 text-sm" role="list">
          <li><a href="/about" class="text-soil-300 hover:text-cream-200 transition-colors">私たちについて</a></li>
          <li><a href="/services" class="text-soil-300 hover:text-cream-200 transition-colors">サービス</a></li>
          <li><a href="/blog" class="text-soil-300 hover:text-cream-200 transition-colors">ブログ</a></li>
          <li><a href="/podcast" class="text-soil-300 hover:text-cream-200 transition-colors">ポッドキャスト</a></li>
          <li><a href="/members" class="text-soil-300 hover:text-cream-200 transition-colors">メンバー</a></li>
          <li><a href="/contact" class="text-soil-300 hover:text-cream-200 transition-colors">お問い合わせ・研修申込</a></li>
        </ul>
      </nav>

      <!-- コンタクト -->
      <div>
        <p class="text-xs font-medium uppercase tracking-widest text-soil-400 mb-4">コンタクト</p>
        <address class="not-italic text-sm text-soil-300 leading-relaxed space-y-1">
          <p>〒399-8303<br />長野県安曇野市穂高513-32</p>
          <p>
            <a href="mailto:info@haniyasu.com" class="hover:text-cream-200 transition-colors">
              info@haniyasu.com
            </a>
          </p>
        </address>
        <a
          href="https://www.instagram.com/haniyasu58/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 mt-3 text-sm text-soil-300 hover:text-cream-200 transition-colors"
          aria-label="Instagram @haniyasu58"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
