        <a
          href="/contact"
          class="inline-block mt-3 px-4 py-2 text-sm font-medium rounded-md border border-terracotta-400 text-terracotta-300 hover:bg-terracotta-500 hover:text-white transition-colors"
        >
          研修を申し込む
        </a>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-soil-700 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-soil-500">
      <p>&copy; {year} ハニヤス合同会社. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="/rss.xml" class="hover:text-soil-300 transition-colors">RSS</a>
      </div>
    </div>
  </div>
</footer>
