---
import type { Service } from '@/lib/types';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="group bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-soil-100">
  {service.image && (
    <div class="aspect-[3/2] overflow-hidden">
      <img
        src={`${service.image.url}?w=640&fm=webp`}
        alt={service.image.alt ?? service.serviceName}
        width="640"
        height="427"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    </div>
  )}
  <div class="p-6">
    <h2 class="font-serif text-xl font-bold text-soil-800 mb-2">
      <a href={`/services/${service.id}`} class="hover:text-terracotta-500 transition-colors">
        {service.serviceName}
      </a>
    </h2>
    <p class="text-sm text-soil-600 leading-relaxed mb-4">{service.lead}</p>
    <a
      href={`/services/${service.id}`}
      class="inline-flex items-center gap-1 text-sm font-medium text-terracotta-500 hover:text-terracotta-600 transition-colors"
      aria-label={`${service.serviceName} の詳細を見る`}
    >
      詳細を見る
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
      </svg>
    </a>
  </div>
</article>
