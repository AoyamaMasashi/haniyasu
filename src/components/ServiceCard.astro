---
import type { Service } from '@/lib/types';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="group bg-white rounded-xl shadow-sm border border-soil-100 flex flex-col sm:flex-row gap-5 p-6 hover:shadow-md transition-shadow">
  <!-- 左: アイコン + タイトル + リード -->
  <div class="flex items-start gap-4 sm:w-64 shrink-0">
    {service.image ? (
      <div class="w-16 h-16 rounded-lg overflow-hidden shrink-0">
        <img
          src={`${service.image.url}?w=128&h=128&fit=crop&fm=webp`}
          alt={service.image.alt ?? service.serviceName}
          width="64"
          height="64"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="w-10 h-10 rounded-lg bg-terracotta-50 border border-terracotta-100 flex items-center justify-center shrink-0 mt-0.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-terracotta-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
    )}
    <div class="min-w-0">
      <h2 class="font-serif text-base font-bold text-soil-800 leading-snug">{service.serviceName}</h2>
      <p class="text-sm text-soil-500 mt-1 leading-relaxed sm:hidden">{service.lead}</p>
    </div>
  </div>

  <!-- 右: リード（デスクトップ）+ ボタン群 -->
  <div class="flex-1 flex flex-col justify-between gap-3 sm:border-l sm:border-soil-100 sm:pl-5">
    <p class="hidden sm:block text-sm text-soil-600 leading-relaxed">{service.lead}</p>
    <div class="flex flex-wrap items-center gap-2">
      {service.id === 'cucurbit' && (
        <a
          href="/services/cucurbit-sales"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-terracotta-500 text-white text-sm font-medium hover:bg-terracotta-600 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" />
            <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd" />
          </svg>
          研修プログラムを見る
        </a>
      )}
      <a
        href={`/services/${service.id}`}
        class="inline-flex items-center gap-1 text-sm font-medium text-terracotta-500 hover:text-terracotta-600 transition-colors"
        aria-label={`${service.serviceName} の詳細を見る`}
      >
        詳細を見る
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</article>
