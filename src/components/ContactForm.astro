---
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const hasTurnstile = Boolean(siteKey);

const services = [
  { value: '', label: '選択してください' },
  { value: 'kukurubitto', label: 'AI研修「ククルビット」' },
  { value: 'service-planning', label: 'サービス・商品企画' },
  { value: 'other', label: 'その他' },
];
---

<div id="form-wrap">
  <!-- 送信成功メッセージ（初期は非表示） -->
  <div id="form-success" class="hidden bg-green-50 border border-green-200 rounded-xl p-8 text-center">
    <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h3 class="font-serif text-xl font-bold text-soil-800 mb-2">お申し込みを受け付けました</h3>
    <p class="text-soil-600 leading-relaxed">
      ご入力のメールアドレスに受付確認メールをお送りしました。<br />
      内容を確認のうえ、担当者より3営業日以内にご連絡いたします。
    </p>
  </div>

  <!-- フォーム -->
  <form
    id="apply-form"
    method="post"
    action="/api/apply"
    novalidate
    class="space-y-6"
    aria-label="研修申込・お問い合わせフォーム"
  >
    <!-- ハニーポット（bot対策: 人間には見えない） -->
    <div class="absolute -left-[9999px] -top-[9999px]" aria-hidden="true">
      <label for="phone_number_confirm">電話番号（入力不要）</label>
      <input
        type="text"
        id="phone_number_confirm"
        name="phone_number_confirm"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <!-- 会社名 -->
    <div>
      <label for="company" class="block text-sm font-medium text-soil-700 mb-1">
        会社名 <span class="text-terracotta-500 ml-0.5" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="company"
        name="company"
        required
        autocomplete="organization"
        placeholder="株式会社〇〇"
        class="w-full px-4 py-3 rounded-lg border border-soil-200 bg-white text-soil-800 placeholder-soil-300 focus:outline-none focus:ring-2 focus:ring-terracotta-400 focus:border-transparent transition-shadow"
        aria-required="true"
      />
      <p class="hidden text-xs text-terracotta-500 mt-1" data-error="company">会社名を入力してください。</p>
    </div>

    <!-- 氏名 -->
    <div>
      <label for="name" class="block text-sm font-medium text-soil-700 mb-1">
        お名前 <span class="text-terracotta-500 ml-0.5" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        placeholder="山田 太郎"
        class="w-full px-4 py-3 rounded-lg border border-soil-200 bg-white text-soil-800 placeholder-soil-300 focus:outline-none focus:ring-2 focus:ring-terracotta-400 focus:border-transparent transition-shadow"
        aria-required="true"
      />
      <p class="hidden text-xs text-terracotta-500 mt-1" data-error="name">お名前を入力してください。</p>
    </div>

    <!-- メールアドレス -->
    <div>
      <label for="email" class="block text-sm font-medium text-soil-700 mb-1">
        メールアドレス <span class="text-terracotta-500 ml-0.5" aria-hidden="true">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        placeholder="taro@example.com"
        class="w-full px-4 py-3 rounded-lg border border-soil-200 bg-white text-soil-800 placeholder-soil-300 focus:outline-none focus:ring-2 focus:ring-terracotta-400 focus:border-transparent transition-shadow"
        aria-required="true"
      />
      <p class="hidden text-xs text-terracotta-500 mt-1" data-error="email">有効なメールアドレスを入力してください。</p>
    </div>

    <!-- 電話番号 -->
    <div>
      <label for="tel" class="block text-sm font-medium text-soil-700 mb-1">
        電話番号 <span class="text-xs font-normal text-soil-400 ml-1">任意</span>
      </label>
      <input
        type="tel"
        id="tel"
        name="tel"
        autocomplete="tel"
        placeholder="03-0000-0000"
        class="w-full px-4 py-3 rounded-lg border border-soil-200 bg-white text-soil-800 placeholder-soil-300 focus:outline-none focus:ring-2 focus:ring-terracotta-400 focus:border-transparent transition-shadow"
      />
    </div>

    <!-- 希望サービス -->
    <div>
      <label for="service" class="block text-sm font-medium text-soil-700 mb-1">
        ご希望のサービス <span class="text-xs font-normal text-soil-400 ml-1">任意</span>
      </label>
      <div class="relative">
        <select
          id="service"
          name="service"
          class="w-full px-4 py-3 rounded-lg border border-soil-200 bg-white text-soil-800 appearance-none focus:outline-none focus:ring-2 focus:ring-terracotta-400 focus:border-transparent transition-shadow pr-10"
        >
          {services.map((s) => (
            <option value={s.value}>{s.label}</option>
          ))}
        </select>
        <svg xmlns="http://www.w3.org/2000/svg" class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-soil-400 pointer-events-none" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </div>
    </div>

    <!-- 想定人数 -->
    <div>
      <label for="participants" class="block text-sm font-medium text-soil-700 mb-1">
        想定参加人数 <span class="text-xs font-normal text-soil-400 ml-1">任意</span>
      </label>
      <input
        type="text"
        id="participants"
        name="participants"
        placeholder="例: 10〜20名"
        class="w-full px-4 py-3 rounded-lg border border-soil-200 bg-white text-soil-800 placeholder-soil-300 focus:outline-none focus:ring-2 focus:ring-terracotta-400 focus:border-transparent transition-shadow"
      />
    </div>

    <!-- メッセージ -->
    <div>
      <label for="message" class="block text-sm font-medium text-soil-700 mb-1">
        ご質問・ご要望 <span class="text-xs font-normal text-soil-400 ml-1">任意</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        placeholder="ご要望や現在の課題など、お気軽にお書きください。"
        class="w-full px-4 py-3 rounded-lg border border-soil-200 bg-white text-soil-800 placeholder-soil-300 focus:outline-none focus:ring-2 focus:ring-terracotta-400 focus:border-transparent transition-shadow resize-y"
      ></textarea>
    </div>

    <!-- Turnstile ウィジェット -->
    {hasTurnstile ? (
      <div>
        <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" data-language="ja"></div>
        <p class="hidden text-xs text-terracotta-500 mt-1" data-error="turnstile">
          ボット確認を完了してください。
        </p>
      </div>
    ) : (
      <p class="text-xs text-soil-400 bg-soil-50 rounded-lg px-4 py-3">
        ※ 開発環境: ボット確認（Turnstile）は本番環境で有効になります。
      </p>
    )}

    <!-- 送信エラーメッセージ -->
    <div id="form-error" class="hidden bg-red-50 border border-red-200 rounded-lg px-4 py-3">
      <p class="text-sm text-red-700" id="form-error-text">送信中にエラーが発生しました。しばらく経ってから再度お試しください。</p>
    </div>

    <!-- 送信ボタン -->
    <button
      type="submit"
      id="submit-btn"
      class="w-full px-6 py-4 rounded-lg bg-terracotta-500 text-white font-medium text-lg hover:bg-terracotta-600 focus:outline-none focus:ring-2 focus:ring-terracotta-400 focus:ring-offset-2 transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
    >
      <span id="submit-label">申し込む・送信する</span>
      <span id="submit-loading" class="hidden">送信中…</span>
    </button>

    <p class="text-xs text-soil-400 text-center leading-relaxed">
      送信いただいた情報はお問い合わせへの対応のみに使用します。
    </p>
  </form>
</div>

{hasTurnstile && (
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
  const form = document.getElementById('apply-form') as HTMLFormElement | null;
  const successEl = document.getElementById('form-success');
  const errorEl = document.getElementById('form-error');
  const errorText = document.getElementById('form-error-text');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('submit-label');
  const submitLoading = document.getElementById('submit-loading');

  function showError(field: string, show: boolean) {
    const el = document.querySelector(`[data-error="${field}"]`);
    if (el) el.classList.toggle('hidden', !show);
  }

  function validateForm(): boolean {
    let valid = true;
    const company = (form?.querySelector('#company') as HTMLInputElement)?.value.trim();
    const name = (form?.querySelector('#name') as HTMLInputElement)?.value.trim();
    const email = (form?.querySelector('#email') as HTMLInputElement)?.value.trim();

    showError('company', !company);
    if (!company) valid = false;

    showError('name', !name);
    if (!name) valid = false;

    const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    showError('email', !emailOk);
    if (!emailOk) valid = false;

    return valid;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl?.classList.add('hidden');

    if (!validateForm()) return;

    submitBtn && (submitBtn.disabled = true);
    submitLabel?.classList.add('hidden');
    submitLoading?.classList.remove('hidden');

    try {
      const data = new FormData(form!);
      const res = await fetch('/api/apply', { method: 'POST', body: data });
      const json = await res.json() as { ok: boolean; error?: string };

      if (json.ok) {
        form?.classList.add('hidden');
        successEl?.classList.remove('hidden');
      } else {
        errorEl?.classList.remove('hidden');
        if (errorText) errorText.textContent = json.error ?? '送信中にエラーが発生しました。';
        submitBtn && (submitBtn.disabled = false);
        submitLabel?.classList.remove('hidden');
        submitLoading?.classList.add('hidden');
      }
    } catch {
      errorEl?.classList.remove('hidden');
      submitBtn && (submitBtn.disabled = false);
      submitLabel?.classList.remove('hidden');
      submitLoading?.classList.add('hidden');
    }
  });
</script>
