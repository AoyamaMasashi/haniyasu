---
import type { NoteArticle } from '@/lib/note';

interface Props {
  post: NoteArticle;
}

const { post } = Astro.props;

const formattedDate = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('ja-JP', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';
---

<article class="group bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-soil-100">
  <a href={post.link} target="_blank" rel="noopener noreferrer" class="block" tabindex="-1" aria-hidden="true">
    {post.thumbnail ? (
      <div class="aspect-[16/9] overflow-hidden">
        <img
          src={post.thumbnail}
          alt={post.title}
          width="640"
          height="360"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="aspect-[16/9] bg-gradient-to-br from-soil-100 via-cream-200 to-terracotta-100 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-soil-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
    )}
  </a>
  <div class="p-5">
    <h2 class="font-serif font-semibold text-soil-800 leading-snug mb-2">
      <a
        href={post.link}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-terracotta-500 transition-colors"
      >
        {post.title}
      </a>
    </h2>
    {post.description && (
      <p class="text-sm text-soil-500 line-clamp-2 mb-2">{post.description}</p>
    )}
    <div class="flex items-center justify-between mt-2">
      {formattedDate && (
        <time datetime={post.publishedAt} class="text-xs text-soil-400">{formattedDate}</time>
      )}
      <span class="text-xs text-soil-400 flex items-center gap-1">
        note で読む
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/>
          <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"/>
        </svg>
      </span>
    </div>
  </div>
</article>
