---
---

<section class="py-12 bg-green-900/90 text-white">
  <div class="container-content max-w-2xl mx-auto text-center">
    <p class="text-xs font-medium tracking-[0.3em] uppercase text-green-300 mb-2">Newsletter</p>
    <h2 class="font-serif text-2xl font-bold mb-2">新着情報をメールで受け取る</h2>
    <p class="text-green-200 text-sm leading-relaxed mb-6">
      ブログ・ポッドキャスト・研修情報など、ハニヤスの最新コンテンツをお届けします。
    </p>

    <div id="nl-wrap">
      <!-- 成功メッセージ -->
      <div id="nl-success" class="hidden bg-white/10 rounded-xl px-6 py-5 text-green-100">
        ご登録ありがとうございます！最新情報をお届けします。
      </div>

      <!-- フォーム -->
      <form id="nl-form" class="flex flex-col sm:flex-row gap-3 justify-center" novalidate>
        <!-- ハニーポット -->
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <input type="text" name="hp" tabindex="-1" autocomplete="off" />
        </div>

        <input
          type="email"
          name="email"
          required
          placeholder="メールアドレスを入力"
          class="flex-1 max-w-xs px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-green-300 focus:outline-none focus:ring-2 focus:ring-white/40 text-sm"
          aria-label="メールアドレス"
        />
        <button
          type="submit"
          id="nl-btn"
          class="px-6 py-3 rounded-lg bg-terracotta-500 text-white text-sm font-medium hover:bg-terracotta-600 transition-colors disabled:opacity-60 disabled:cursor-not-allowed whitespace-nowrap"
        >
          <span id="nl-label">登録する</span>
          <span id="nl-loading" class="hidden">送信中…</span>
        </button>
      </form>
      <p id="nl-error" class="hidden mt-3 text-sm text-red-300"></p>
      <p class="mt-3 text-xs text-green-400">いつでも配信解除できます。</p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('nl-form') as HTMLFormElement | null;
  const successEl = document.getElementById('nl-success');
  const errorEl = document.getElementById('nl-error');
  const btn = document.getElementById('nl-btn') as HTMLButtonElement | null;
  const label = document.getElementById('nl-label');
  const loading = document.getElementById('nl-loading');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (errorEl) errorEl.classList.add('hidden');

    const email = (form.querySelector('input[name="email"]') as HTMLInputElement)?.value.trim();
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      if (errorEl) {
        errorEl.textContent = '有効なメールアドレスを入力してください。';
        errorEl.classList.remove('hidden');
      }
      return;
    }

    if (btn) btn.disabled = true;
    label?.classList.add('hidden');
    loading?.classList.remove('hidden');

    try {
      const fd = new FormData(form);
      const res = await fetch('/api/subscribe', { method: 'POST', body: fd });
      const json = await res.json() as { ok: boolean; error?: string };

      if (json.ok) {
        form.classList.add('hidden');
        successEl?.classList.remove('hidden');
      } else {
        if (errorEl) {
          errorEl.textContent = json.error ?? '登録中にエラーが発生しました。';
          errorEl.classList.remove('hidden');
        }
        if (btn) btn.disabled = false;
        label?.classList.remove('hidden');
        loading?.classList.add('hidden');
      }
    } catch {
      if (errorEl) {
        errorEl.textContent = '通信エラーが発生しました。しばらく経ってから再度お試しください。';
        errorEl.classList.remove('hidden');
      }
      if (btn) btn.disabled = false;
      label?.classList.remove('hidden');
      loading?.classList.add('hidden');
    }
  });
</script>
