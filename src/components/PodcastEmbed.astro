---
interface Props {
  embedUrl: string;
  title: string;
}

const { embedUrl, title } = Astro.props;

// Spotify の埋め込み URL を安全に正規化
function normalizeEmbedUrl(url: string): string {
  // spotify.com/episode/... → open.spotify.com/embed/episode/...
  if (url.includes('spotify.com') && !url.includes('/embed/')) {
    return url.replace('open.spotify.com/', 'open.spotify.com/embed/');
  }
  return url;
}

const safeUrl = normalizeEmbedUrl(embedUrl);
---

<div class="rounded-xl overflow-hidden my-6 shadow-sm">
  <iframe
    src={safeUrl}
    title={`${title} のポッドキャスト再生`}
    width="100%"
    height="152"
    frameborder="0"
    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    loading="lazy"
    class="block"
  ></iframe>
</div>
