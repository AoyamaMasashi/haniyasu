---
import type { Member } from '@/lib/types';

interface Props {
  member: Member;
}

const { member } = Astro.props;
---

<article class="bg-white rounded-xl shadow-sm border border-soil-100 flex flex-col sm:flex-row gap-6 p-6 sm:p-8">
  <!-- 左: 写真 + 名前 -->
  <div class="flex flex-col items-center sm:items-start sm:w-44 shrink-0">
    {member.photo ? (
      <img
        src={`${member.photo.url}?w=240&h=240&fit=crop&fm=webp`}
        alt={member.photo.alt ?? member.name}
        width="120"
        height="120"
        class="w-28 h-28 rounded-full object-cover border-4 border-soil-100 mb-3"
        loading="lazy"
      />
    ) : (
      <div class="w-28 h-28 rounded-full bg-soil-100 flex items-center justify-center mb-3 border-4 border-soil-200">
        <span class="text-soil-400 font-serif text-3xl">{member.name.charAt(0)}</span>
      </div>
    )}
    <h2 class="font-serif text-lg font-bold text-soil-800 text-center sm:text-left">{member.name}</h2>
    <p class="text-xs text-terracotta-600 font-medium mt-1 text-center sm:text-left">{member.role}</p>
  </div>

  <!-- 右: プロフィール -->
  {member.profile && (
    <div class="flex-1 flex items-center border-t border-soil-100 pt-4 sm:border-t-0 sm:pt-0 sm:border-l sm:border-soil-100 sm:pl-8">
      <div class="text-sm text-soil-600 leading-relaxed" set:html={member.profile} />
    </div>
  )}
</article>
