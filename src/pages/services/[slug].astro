---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getAllServiceIds, getService } from '@/lib/microcms';

export async function getStaticPaths() {
  const ids = await getAllServiceIds();
  return ids.map((id) => ({ params: { slug: id } }));
}

const { slug } = Astro.params;
const service = await getService(slug);

if (!service) return Astro.redirect('/services');
---

<ArticleLayout
  title={`${service.serviceName} | サービス | ハニヤス合同会社`}
  description={service.lead}
  thumbnail={service.image}
  backHref="/services"
  backLabel="サービス一覧に戻る"
>
  <!-- キャッチコピー -->
  <p class="text-xl text-soil-600 italic mb-8 not-prose">{service.lead}</p>

  <!-- 本文 -->
  <Fragment set:html={service.body} />

  <!-- CTA -->
  <div class="not-prose mt-12 p-8 bg-soil-50 rounded-xl border border-soil-200 text-center">
    <h3 class="font-serif text-xl font-bold text-soil-800 mb-3">{service.serviceName} のご相談・申し込み</h3>
    <p class="text-soil-600 mb-6 leading-relaxed">
      詳細や料金についてはお気軽にお問い合わせください。
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      {slug === 'cucurbit' && (
        <a
          href="/services/cucurbit-sales"
          class="inline-flex items-center justify-center gap-2 px-8 py-3 rounded-md bg-terracotta-500 text-white font-medium hover:bg-terracotta-600 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" />
            <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd" />
          </svg>
          研修プログラムを詳しく見る
        </a>
      )}
      <a
        href="/contact"
        class={`inline-block px-8 py-3 rounded-md font-medium transition-colors ${slug === 'cucurbit' ? 'border border-terracotta-400 text-terracotta-600 hover:bg-terracotta-50' : 'bg-terracotta-500 text-white hover:bg-terracotta-600'}`}
      >
        研修を申し込む・お問い合わせ
      </a>
    </div>
  </div>
</ArticleLayout>
