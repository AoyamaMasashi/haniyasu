---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MemberCard from '@/components/MemberCard.astro';
import { getMemberList } from '@/lib/microcms';

const { contents: members } = await getMemberList();
---

<BaseLayout
  title="メンバー紹介 | ハニヤス合同会社"
  description="ハニヤス合同会社のメンバーをご紹介します。"
>
  <!-- ページヘッダー -->
  <section class="py-10 bg-gradient-to-b from-cream-100 to-cream-50">
    <div class="container-content text-center">
      <p class="text-xs font-medium tracking-[0.3em] uppercase text-soil-400 mb-3">Members</p>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-soil-800">メンバー紹介</h1>
    </div>
  </section>

  <section class="section-padding bg-cream-50">
    <div class="container-content">
      {members.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-4xl mx-auto">
          {members.map((member) => <MemberCard member={member} />)}
        </div>
      ) : (
        <div class="text-center py-20 text-soil-400">
          <p class="font-serif text-lg">メンバー情報は microCMS に登録すると表示されます。</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
