---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getNewsFeed, CATEGORY_COLOR, fmtDate } from '@/lib/newsFeed';

const items = await getNewsFeed(50);
---

<BaseLayout
  title="お知らせ | ハニヤス合同会社"
  description="ハニヤス合同会社からの最新情報をご覧いただけます。"
>
  <section class="py-10 bg-gradient-to-b from-cream-100 to-cream-50">
    <div class="container-content text-center">
      <p class="text-xs font-medium tracking-[0.3em] uppercase text-soil-400 mb-3">News</p>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-soil-800">お知らせ・最新情報</h1>
      <p class="mt-3 text-sm text-soil-500">ブログ・ポッドキャスト・お知らせをまとめて確認できます。</p>
    </div>
  </section>

  <section class="section-padding bg-cream-50">
    <div class="container-content max-w-2xl mx-auto">
      {items.length > 0 ? (
        <ul class="divide-y divide-soil-100">
          {items.map((item) => {
            const colorClass = CATEGORY_COLOR[item.category] ?? 'bg-soil-100 text-soil-600';
            const hasLink = item.href || item.newsId;
            const linkHref = item.href ?? (item.newsId ? `/news/${item.newsId}` : undefined);
            const isExternal = item.href?.startsWith('http');
            return (
              <li>
                {hasLink ? (
                  <a
                    href={linkHref}
                    target={isExternal ? '_blank' : undefined}
                    rel={isExternal ? 'noopener noreferrer' : undefined}
                    class="group flex items-start gap-3 py-4 hover:bg-soil-50 -mx-4 px-4 rounded-lg transition-colors"
                  >
                    <time class="shrink-0 text-xs text-soil-400 w-24 pt-1">{fmtDate(item.date)}</time>
                    <span class:list={['shrink-0 text-xs font-medium px-2 py-0.5 rounded mt-0.5', colorClass]}>
                      {item.category}
                    </span>
                    <span class="flex-1 text-sm text-soil-800 group-hover:text-terracotta-600 transition-colors leading-snug">
                      {item.title}
                      {isExternal && (
                        <svg xmlns="http://www.w3.org/2000/svg" class="inline-block w-3 h-3 ml-1 opacity-40" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                          <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
                          <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
                        </svg>
                      )}
                    </span>
                  </a>
                ) : (
                  <div class="flex items-start gap-3 py-4">
                    <time class="shrink-0 text-xs text-soil-400 w-24 pt-1">{fmtDate(item.date)}</time>
                    <span class:list={['shrink-0 text-xs font-medium px-2 py-0.5 rounded mt-0.5', colorClass]}>
                      {item.category}
                    </span>
                    <span class="flex-1 text-sm text-soil-800 leading-snug">{item.title}</span>
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      ) : (
        <div class="text-center py-20 text-soil-400">
          <p class="font-serif text-lg">情報はまだありません。</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
