---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getAllNewsIds, getNewsItem } from '@/lib/microcms';

export async function getStaticPaths() {
  const ids = await getAllNewsIds();
  return ids.map((id) => ({ params: { slug: id } }));
}

const { slug } = Astro.params;
const item = await getNewsItem(slug);

if (!item) return Astro.redirect('/news');

function fmt(iso: string) {
  return new Date(iso).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<ArticleLayout
  title={`${item.title} | お知らせ | ハニヤス合同会社`}
  description={item.title}
  backHref="/news"
  backLabel="お知らせ一覧に戻る"
>
  <div class="not-prose mb-6 flex items-center gap-3 text-sm text-soil-400">
    {item.category && <span class="px-2 py-0.5 rounded bg-soil-100 text-soil-600 font-medium">{item.category}</span>}
    <time>{fmt(item.publishedAt)}</time>
  </div>

  {item.body && <Fragment set:html={item.body} />}
</ArticleLayout>
