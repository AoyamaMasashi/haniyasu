---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import PodcastEmbed from '@/components/PodcastEmbed.astro';
import { getAllPodcastIds, getPodcastEpisode } from '@/lib/microcms';

export async function getStaticPaths() {
  const ids = await getAllPodcastIds();
  return ids.map((id) => ({ params: { slug: id } }));
}

const { slug } = Astro.params;
const episode = await getPodcastEpisode(slug);

if (!episode) return Astro.redirect('/podcast');

const platformLabels: Record<string, string> = {
  spotify: 'Spotify',
  apple: 'Apple Podcasts',
  amazon: 'Amazon Music',
  youtube: 'YouTube',
  other: 'その他',
};
---

<ArticleLayout
  title={`${episode.episodeTitle} | ポッドキャスト | ハニヤス合同会社`}
  description={episode.description?.replace(/<[^>]+>/g, '').slice(0, 120)}
  publishedAt={episode.publishedAt}
  type="article"
  backHref="/podcast"
  backLabel="ポッドキャスト一覧に戻る"
>
  <!-- 埋め込みプレーヤー -->
  {episode.embedUrl && (
    <div class="not-prose mb-8">
      <PodcastEmbed embedUrl={episode.embedUrl} title={episode.episodeTitle} />
    </div>
  )}

  <!-- 各プラットフォームへのリンク -->
  {episode.platformLinks && episode.platformLinks.length > 0 && (
    <div class="not-prose mb-8 flex flex-wrap gap-3">
      {episode.platformLinks.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-soil-300 text-sm text-soil-700 hover:bg-soil-50 transition-colors"
        >
          {platformLabels[link.platform] ?? link.platform} で聴く ↗
        </a>
      ))}
    </div>
  )}

  <!-- 概要 -->
  <Fragment set:html={episode.description} />

  <!-- 関連 note 記事 -->
  {episode.relatedBlogUrl && (
    <div class="not-prose mt-12 p-6 bg-soil-50 rounded-xl border border-soil-200">
      <p class="text-sm font-medium text-soil-600 mb-2">このエピソードのまとめ記事（note）</p>
      <a
        href={episode.relatedBlogUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-terracotta-500 hover:text-terracotta-600 font-medium transition-colors"
      >
        note で読む ↗
      </a>
    </div>
  )}
</ArticleLayout>
