---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import BlogCard from '@/components/BlogCard.astro';
import PodcastCard from '@/components/PodcastCard.astro';
import { getServiceList, getPodcastList, getNewsList } from '@/lib/microcms';
import { getNoteArticles } from '@/lib/note';

const [servicesData, blogPosts, podcastData, newsData] = await Promise.all([
  getServiceList(),
  getNoteArticles(3),
  getPodcastList(3, 0),
  getNewsList(5),
]);

const services = servicesData.contents;
const episodes = podcastData.contents;
const newsItems = newsData.contents;

function fmtDate(iso: string) {
  return new Date(iso).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title="ハニヤス合同会社 | 人創りで豊かな未来を">
  <!-- ヒーロー -->
  <section class="relative overflow-hidden bg-gradient-to-br from-cream-50 via-cream-100 to-soil-100 pt-16 pb-16 md:pt-24 md:pb-20">
    <!-- 背景装飾 -->
    <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-terracotta-100/40 blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-0 -left-20 w-72 h-72 rounded-full bg-green-100/50 blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-gradient-to-b from-terracotta-300 via-soil-400 to-transparent" aria-hidden="true"></div>

    <div class="container-content text-center relative">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/70 border border-soil-200 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-terracotta-400"></span>
        <p class="text-xs font-medium tracking-[0.2em] text-soil-600 uppercase">人創りで、豊かな未来を</p>
      </div>
      <h1 class="font-serif text-4xl md:text-6xl font-bold text-soil-800 leading-tight mb-5">
        未来のタネを、<br class="sm:hidden" />今ここに
      </h1>
      <p class="max-w-xl mx-auto text-base md:text-lg text-soil-600 leading-relaxed mb-8">
        ハニヤス合同会社は、教育支援・経営支援を通じて<br class="hidden sm:block" />
        企業と人が豊かに育つ土壌をつくります。
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/services" class="px-7 py-3.5 rounded-lg bg-terracotta-500 text-white font-medium hover:bg-terracotta-600 transition-colors shadow-md hover:shadow-lg">
          サービスを見る
        </a>
        <a href="/contact" class="px-7 py-3.5 rounded-lg border-2 border-soil-400 text-soil-700 font-medium hover:bg-soil-100 transition-colors">
          研修を申し込む
        </a>
      </div>
    </div>
  </section>

  <!-- ミッション -->
  <section class="section-padding bg-white border-y border-soil-100">
    <div class="container-content text-center max-w-2xl mx-auto">
      <div class="flex items-center justify-center gap-3 mb-4">
        <div class="h-px w-12 bg-terracotta-300"></div>
        <p class="text-xs font-medium tracking-[0.3em] uppercase text-soil-400">Mission</p>
        <div class="h-px w-12 bg-terracotta-300"></div>
      </div>
      <h2 class="font-serif text-2xl md:text-3xl font-bold text-soil-800 mb-6">
        「人創り」が、すべての原点
      </h2>
      <p class="text-soil-600 leading-loose">
        ハニヤス（Haniyasu）という名は、古来より日本で「大地・土」を象徴する言葉に由来します。<br />
        土が種を育み、やがて豊かな実りをもたらすように、<br />
        私たちは「人を育てること」を通じて、組織と社会の実りをつくります。
      </p>
      <a href="/about" class="inline-block mt-8 text-sm font-medium text-terracotta-500 hover:text-terracotta-600 border-b border-terracotta-300 hover:border-terracotta-500 transition-colors pb-0.5">
        会社・理念についてもっと見る →
      </a>
    </div>
  </section>

  <!-- お知らせ -->
  {newsItems.length > 0 && (
    <section class="py-8 bg-cream-50 border-b border-soil-100">
      <div class="container-content max-w-3xl mx-auto">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="w-1 h-5 rounded-full bg-terracotta-400"></div>
            <p class="text-sm font-medium text-soil-700">お知らせ</p>
          </div>
          <a href="/news" class="text-xs text-terracotta-500 hover:text-terracotta-600 transition-colors">
            すべて見る →
          </a>
        </div>
        <ul class="divide-y divide-soil-100">
          {newsItems.map((item) => (
            <li>
              {item.body ? (
                <a href={`/news/${item.id}`} class="group flex items-baseline gap-4 py-3 hover:text-terracotta-600 transition-colors">
                  <time class="shrink-0 text-xs text-soil-400 w-24">{fmtDate(item.publishedAt)}</time>
                  {item.category && <span class="shrink-0 text-xs px-1.5 py-0.5 rounded bg-soil-100 text-soil-500">{item.category}</span>}
                  <span class="text-sm text-soil-800 group-hover:text-terracotta-600 transition-colors">{item.title}</span>
                </a>
              ) : (
                <div class="flex items-baseline gap-4 py-3">
                  <time class="shrink-0 text-xs text-soil-400 w-24">{fmtDate(item.publishedAt)}</time>
                  {item.category && <span class="shrink-0 text-xs px-1.5 py-0.5 rounded bg-soil-100 text-soil-500">{item.category}</span>}
                  <span class="text-sm text-soil-800">{item.title}</span>
                </div>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- サービス一覧 -->
  {services.length > 0 && (
    <section class="section-padding bg-soil-50">
      <div class="container-content">
        <div class="text-center mb-10">
          <div class="flex items-center justify-center gap-3 mb-3">
            <div class="h-px w-10 bg-soil-300"></div>
            <p class="text-xs font-medium tracking-[0.3em] uppercase text-soil-400">Services</p>
            <div class="h-px w-10 bg-soil-300"></div>
          </div>
          <h2 class="font-serif text-2xl md:text-3xl font-bold text-soil-800">サービス</h2>
        </div>
        <div class="flex flex-col gap-4 max-w-3xl mx-auto">
          {services.map((service) => <ServiceCard service={service} />)}
        </div>
        <div class="text-center mt-8">
          <a href="/services" class="inline-block text-sm font-medium text-terracotta-500 hover:text-terracotta-600 border-b border-terracotta-300 hover:border-terracotta-500 transition-colors pb-0.5">
            すべてのサービスを見る →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- 最新ブログ -->
  {blogPosts.length > 0 && (
    <section class="section-padding bg-cream-50">
      <div class="container-content">
        <div class="text-center mb-10">
          <div class="flex items-center justify-center gap-3 mb-3">
            <div class="h-px w-10 bg-soil-300"></div>
            <p class="text-xs font-medium tracking-[0.3em] uppercase text-soil-400">Blog</p>
            <div class="h-px w-10 bg-soil-300"></div>
          </div>
          <h2 class="font-serif text-2xl md:text-3xl font-bold text-soil-800">最新ブログ</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {blogPosts.map((post) => <BlogCard post={post} />)}
        </div>
        <div class="text-center mt-8">
          <a href="/blog" class="inline-block text-sm font-medium text-terracotta-500 hover:text-terracotta-600 border-b border-terracotta-300 hover:border-terracotta-500 transition-colors pb-0.5">
            すべての記事を見る →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- 最新ポッドキャスト -->
  {episodes.length > 0 && (
    <section class="section-padding bg-soil-50">
      <div class="container-content">
        <div class="text-center mb-10">
          <div class="flex items-center justify-center gap-3 mb-3">
            <div class="h-px w-10 bg-soil-300"></div>
            <p class="text-xs font-medium tracking-[0.3em] uppercase text-soil-400">Podcast</p>
            <div class="h-px w-10 bg-soil-300"></div>
          </div>
          <h2 class="font-serif text-2xl md:text-3xl font-bold text-soil-800">ポッドキャスト</h2>
        </div>
        <div class="flex flex-col gap-4 max-w-2xl mx-auto">
          {episodes.map((ep) => <PodcastCard episode={ep} />)}
        </div>
        <div class="text-center mt-8">
          <a href="/podcast" class="inline-block text-sm font-medium text-terracotta-500 hover:text-terracotta-600 border-b border-terracotta-300 hover:border-terracotta-500 transition-colors pb-0.5">
            すべてのエピソードを聴く →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA セクション -->
  <section class="py-20 bg-soil-800 text-center">
    <div class="container-content max-w-xl">
      <h2 class="font-serif text-2xl md:text-3xl font-bold text-cream-100 mb-4">
        研修・支援のご相談は<br class="sm:hidden" />お気軽にどうぞ
      </h2>
      <p class="text-soil-300 leading-relaxed mb-8">
        AI研修「ククルビット」をはじめ、<br />
        貴社の課題に合わせたプランをご提案します。
      </p>
      <a
        href="/contact"
        class="inline-block px-8 py-3 rounded-md bg-terracotta-500 text-white font-medium hover:bg-terracotta-600 transition-colors"
      >
        研修を申し込む・お問い合わせ
      </a>
    </div>
  </section>
</BaseLayout>
