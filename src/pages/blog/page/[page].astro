---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogCard from '@/components/BlogCard.astro';
import Pagination from '@/components/Pagination.astro';
import { getBlogList } from '@/lib/microcms';

const PER_PAGE = 12;

export async function getStaticPaths() {
  const perPage = 12;
  const { totalCount } = await getBlogList(1, perPage);
  const totalPages = Math.max(1, Math.ceil(totalCount / perPage));
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const page = Number(Astro.params.page);
const { contents: posts, totalCount } = await getBlogList(page, PER_PAGE);
const totalPages = Math.ceil(totalCount / PER_PAGE);

if (posts.length === 0) return Astro.redirect('/blog');
---

<BaseLayout
  title={`ブログ ${page}ページ目 | ハニヤス合同会社`}
  description={`ハニヤス合同会社のブログ ${page}ページ目`}
>
  <!-- ページヘッダー -->
  <section class="py-16 bg-gradient-to-b from-cream-100 to-cream-50">
    <div class="container-content text-center">
      <p class="text-xs font-medium tracking-[0.3em] uppercase text-soil-400 mb-3">Blog</p>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-soil-800">ブログ</h1>
    </div>
  </section>

  <section class="section-padding bg-cream-50">
    <div class="container-content">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => <BlogCard post={post} />)}
      </div>
      <Pagination currentPage={page} totalPages={totalPages} basePath="/blog" />
    </div>
  </section>
</BaseLayout>
