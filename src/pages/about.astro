---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAbout } from '@/lib/microcms';

const about = await getAbout();
---

<BaseLayout
  title="私たちについて | ハニヤス合同会社"
  description={about?.mission
    ? `${about.mission} — ハニヤス合同会社の企業理念・ミッション`
    : 'ハニヤス合同会社の企業理念・ミッション・由来をご紹介します。'}
>
  <!-- ページヘッダー -->
  <section class="py-16 bg-gradient-to-b from-cream-100 to-cream-50">
    <div class="container-content text-center">
      <p class="text-xs font-medium tracking-[0.3em] uppercase text-soil-400 mb-3">About</p>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-soil-800">私たちについて</h1>
    </div>
  </section>

  <section class="section-padding bg-cream-50">
    <div class="container-content max-w-3xl">
      {about ? (
        <div>
          <!-- ミッション -->
          <div class="mb-12 text-center">
            <h2 class="font-serif text-2xl md:text-3xl font-bold text-soil-800 leading-snug">
              {about.mission}
            </h2>
          </div>

          <!-- メインイメージ -->
          {about.image && (
            <div class="mb-10 rounded-xl overflow-hidden aspect-[16/7]">
              <img
                src={`${about.image.url}?w=1200&fm=webp`}
                alt={about.image.alt ?? about.mission}
                width="1200"
                height="525"
                class="w-full h-full object-cover"
                loading="eager"
              />
            </div>
          )}

          <!-- 本文 -->
          <div class="prose mx-auto" set:html={about.body} />

          <!-- 社名の由来 -->
          {about.originStory && (
            <div class="mt-12 p-8 bg-soil-50 rounded-xl border-l-4 border-terracotta-400">
              <h3 class="font-serif text-xl font-bold text-soil-800 mb-4">社名の由来</h3>
              <div class="prose" set:html={about.originStory} />
            </div>
          )}
        </div>
      ) : (
        <div class="text-center py-20 text-soil-400">
          <p class="font-serif text-lg">microCMS に「about」コンテンツを登録すると表示されます。</p>
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-soil-800 text-center">
    <div class="container-content max-w-lg">
      <h2 class="font-serif text-2xl font-bold text-cream-100 mb-4">ご一緒しませんか</h2>
      <p class="text-soil-300 mb-8 leading-relaxed">
        研修・経営支援のご相談はお気軽にどうぞ。
      </p>
      <a
        href="/contact"
        class="inline-block px-8 py-3 rounded-md bg-terracotta-500 text-white font-medium hover:bg-terracotta-600 transition-colors"
      >
        お問い合わせ・研修申込
      </a>
    </div>
  </section>
</BaseLayout>
